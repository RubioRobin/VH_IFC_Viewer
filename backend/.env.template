# ============================================================
# VH IFC Viewer — Backend Omgevingsvariabelen
# ============================================================
# Kopieer dit bestand naar .env en vul de juiste waarden in.
# Commando: copy .env.template .env
#
# WAARSCHUWING: Commit NOOIT het .env bestand naar git!
# ============================================================

# --- Server Configuratie ---
PORT=3001
NODE_ENV=development

# --- CORS & URL Configuratie ---
# Vul hier de URL van je frontend in (voor CORS-beveiliging)
FRONTEND_URL=https://jouw-frontend.vercel.app

# Vul hier de URL van de viewer in (voor QR-code generatie)
VIEWER_URL=https://jouw-frontend.vercel.app

# --- Supabase Configuratie ---
# Haal deze waarden op uit: Supabase Dashboard > Project Settings > API

# Project URL
SUPABASE_URL=https://jouw-project-id.supabase.co

# Anon/Public key (veilig voor gebruik in backend, maar NIET in frontend)
SUPABASE_KEY=jouw-anon-key-hier

# Service Role Key — KRITIEK: NOOIT delen met frontend of Revit add-in!
# Gebruik deze om Row Level Security te omzeilen voor backend-operaties.
# Haal op via: Supabase Dashboard > Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=jouw-service-role-key-hier

# --- Sessie Beveiliging ---
# Genereer een veilige sleutel met:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=jouw-lange-willekeurige-sessie-sleutel-hier

# --- Revit Plugin Authenticatie ---
# JWT Secret voor plugin-tokens (gebruik een lange willekeurige string)
# Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=jouw-jwt-geheim-hier

# Plugin client-ID (kan worden aangepast)
PLUGIN_CLIENT_ID=revit_plugin

# Plugin client-secret (gebruik een sterke willekeurige string)
# Genereer met: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PLUGIN_CLIENT_SECRET=jouw-plugin-client-geheim-hier

# --- Admin API-sleutel (voor Revit add-in authenticatie) ---
# Genereer een veilige willekeurige sleutel:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Deel deze sleutel ALLEEN met geautoriseerde Revit add-in gebruikers.
ADMIN_API_KEY=jouw-admin-api-sleutel-hier
