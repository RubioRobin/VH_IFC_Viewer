<Window x:Class="VH_IFC_QR.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VH IFC" MinHeight="210" Width="460" MaxHeight="430"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI"
        SizeToContent="Height">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
            CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="3" Opacity="0.15"/>
        </Border.Effect>
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock x:Name="IconBlock" Text="i" FontSize="26" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#111827"/>
                <TextBlock x:Name="TitleBlock" FontSize="18" FontWeight="Bold" Foreground="#111827"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" MaxHeight="230" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="MessageBlock" FontSize="14" Foreground="#374151"
                           TextWrapping="Wrap" LineHeight="21" VerticalAlignment="Top"/>
            </ScrollViewer>

            <Button Grid.Row="2" Content="OK" Click="BtnOk_Click" Margin="0,20,0,0"
                    HorizontalAlignment="Right" Width="100" Height="42"
                    Background="#C1A979" Foreground="#111827" BorderThickness="0"
                    FontWeight="SemiBold" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#A98F5F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#8D774F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
