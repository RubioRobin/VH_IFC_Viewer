<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Configurations>Debug;Release</Configurations>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OriginalExporterSourceDir>OriginalExporter\VHExportAssemblies\IFCExportSingleAssembly\</OriginalExporterSourceDir>
    <OriginalExporterRuntimeDir>$(OriginalExporterSourceDir)bin\Debug\net8.0-windows7.0\</OriginalExporterRuntimeDir>
    <RevitAddinOutputDir>$(APPDATA)\Autodesk\Revit\Addins\2025\VH_IFC_QR_bundled\</RevitAddinOutputDir>
    <RevitAddinManifestPath>$(APPDATA)\Autodesk\Revit\Addins\2025\VH_IFC_QR.addin</RevitAddinManifestPath>
    <CodeSigningCertificatePath Condition="'$(CodeSigningCertificatePath)' == ''">$(VH_CODE_SIGN_CERT)</CodeSigningCertificatePath>
    <CodeSigningCertificatePassword Condition="'$(CodeSigningCertificatePassword)' == ''">$(VH_CODE_SIGN_PASSWORD)</CodeSigningCertificatePassword>
    <CodeSigningTimestampUrl Condition="'$(CodeSigningTimestampUrl)' == ''">http://timestamp.digicert.com</CodeSigningTimestampUrl>
    <SignToolPath Condition="'$(SignToolPath)' == ''">signtool</SignToolPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2025.0.*" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Antlr4.Runtime">
      <HintPath>$(OriginalExporterRuntimeDir)Antlr4.Runtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Autodesk.UI.Windows">
      <HintPath>$(OriginalExporterRuntimeDir)Autodesk.UI.Windows.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Autodesk.Weave.Wpf">
      <HintPath>$(OriginalExporterRuntimeDir)Autodesk.Weave.Wpf.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="CodeLibrary">
      <HintPath>$(OriginalExporterRuntimeDir)CodeLibrary.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="IFCExporterUIOverride">
      <HintPath>$(OriginalExporterRuntimeDir)IFCExporterUIOverride.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="IFCExportSingleAssemblyUI">
      <HintPath>$(OriginalExporterRuntimeDir)IFCExportSingleAssemblyUI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="IntfIFCAPI">
      <HintPath>$(OriginalExporterRuntimeDir)IntfIFCAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Revit.IFC.Common">
      <HintPath>$(OriginalExporterRuntimeDir)Revit.IFC.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Revit.IFC.Export">
      <HintPath>$(OriginalExporterRuntimeDir)Revit.IFC.Export.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="RevitAPIIFC">
      <HintPath>$(OriginalExporterRuntimeDir)RevitAPIIFC.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UserInterfaceUtility">
      <HintPath>$(OriginalExporterRuntimeDir)UserInterfaceUtility.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VHCreateSheets">
      <HintPath>$(OriginalExporterRuntimeDir)VHCreateSheets.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="VhExportSelectionWindow.xaml.cs" />
    <ApplicationDefinition Remove="OriginalExporter\**\*.xaml" />
    <Compile Remove="OriginalExporter\**\*.cs" />
    <EmbeddedResource Remove="OriginalExporter\**\*.*" />
    <None Remove="OriginalExporter\**\*.*" />
    <Page Remove="VhExportSelectionWindow.xaml" />
    <Page Remove="OriginalExporter\**\*.xaml" />
    <Resource Remove="OriginalExporter\**\*.*" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(OriginalExporterSourceDir)ExecuteAddin.cs" />
    <Compile Include="$(OriginalExporterSourceDir)Classes\*.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>RELEASE;TRACE</DefineConstants>
    <DebugType>pdbonly</DebugType>
    <OutputPath>bin\Release\</OutputPath>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <Target Name="CodeSignAddin" AfterTargets="Build" BeforeTargets="CopyToRevitAddins"
          Condition="'$(CodeSigningCertificatePath)' != '' And Exists('$(CodeSigningCertificatePath)')">
    <Exec Condition="'$(CodeSigningCertificatePassword)' != ''"
          Command="&quot;$(SignToolPath)&quot; sign /f &quot;$(CodeSigningCertificatePath)&quot; /p &quot;$(CodeSigningCertificatePassword)&quot; /fd SHA256 /tr &quot;$(CodeSigningTimestampUrl)&quot; /td SHA256 &quot;$(TargetPath)&quot;" />
    <Exec Condition="'$(CodeSigningCertificatePassword)' == ''"
          Command="&quot;$(SignToolPath)&quot; sign /f &quot;$(CodeSigningCertificatePath)&quot; /fd SHA256 /tr &quot;$(CodeSigningTimestampUrl)&quot; /td SHA256 &quot;$(TargetPath)&quot;" />
  </Target>

  <Target Name="RemoveLegacyOriginalExporterRuntime" BeforeTargets="CopyToRevitAddins"
          Condition="'$(CopyToRevitAddins)' != 'false'">
    <RemoveDir Directories="$(TargetDir)OriginalExporter" />
    <RemoveDir Directories="$(RevitAddinOutputDir)" />
  </Target>

  <Target Name="CopyToRevitAddins" AfterTargets="Build" Condition="'$(CopyToRevitAddins)' != 'false'">
    <MakeDir Directories="$(RevitAddinOutputDir)" />
    <ItemGroup>
      <AddinRuntimeOutput Include="$(TargetDir)**\*.*" />
      <AddinSourceAsset Include="$(MSBuildProjectDirectory)\icon_export.png" />
    </ItemGroup>
    <Copy SourceFiles="@(AddinRuntimeOutput)"
          DestinationFiles="@(AddinRuntimeOutput->'$(RevitAddinOutputDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AddinSourceAsset)"
          DestinationFolder="$(RevitAddinOutputDir)"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <RevitAddinManifestLine Include="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;" />
      <RevitAddinManifestLine Include="&lt;RevitAddIns&gt;" />
      <RevitAddinManifestLine Include="  &lt;AddIn Type=&quot;Application&quot;&gt;" />
      <RevitAddinManifestLine Include="    &lt;Name&gt;VH IFC QR Upload&lt;/Name&gt;" />
      <RevitAddinManifestLine Include="    &lt;Assembly&gt;$(RevitAddinOutputDir)$(AssemblyName).dll&lt;/Assembly&gt;" />
      <RevitAddinManifestLine Include="    &lt;AddInId&gt;0F3C8A7B-E2D1-4B8F-9C4D-8A2E1F3B4C5D&lt;/AddInId&gt;" />
      <RevitAddinManifestLine Include="    &lt;FullClassName&gt;VH_IFC_QR.App&lt;/FullClassName&gt;" />
      <RevitAddinManifestLine Include="    &lt;VendorId&gt;VH_ENGINEERING&lt;/VendorId&gt;" />
      <RevitAddinManifestLine Include="    &lt;VendorDescription&gt;VH Engineering&lt;/VendorDescription&gt;" />
      <RevitAddinManifestLine Include="  &lt;/AddIn&gt;" />
      <RevitAddinManifestLine Include="&lt;/RevitAddIns&gt;" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(RevitAddinManifestPath)"
      Lines="@(RevitAddinManifestLine)"
      Overwrite="true"
      Encoding="UTF-8" />
  </Target>
</Project>
