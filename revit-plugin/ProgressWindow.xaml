<Window x:Class="VH_IFC_QR.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verwerken..."
        Height="160" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header / Drag Area -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseDown" Margin="0,0,0,15">
                <TextBlock Text="Even geduld..." FontWeight="Bold" FontSize="16" Foreground="#111827" HorizontalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="lblMessage" Text="Initialiseren..." FontSize="14" Foreground="#6B7280" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15"/>
                <ProgressBar x:Name="progressBar" Height="8" Foreground="#4F46E5" Background="#F3F4F6" BorderThickness="0">
                     <ProgressBar.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </ProgressBar.Resources>
                </ProgressBar>
            </StackPanel>
        </Grid>
    </Border>
</Window>
