# Backend Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=https://vh-ifc-viewer.vercel.app

# Viewer URL (for QR code generation)
# In production, this should be your viewer domain
VIEWER_URL=https://vh-ifc-viewer.vercel.app

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co

# IMPORTANT: Use ANON key for frontend, SERVICE ROLE key for backend
# This key is safe to be public but should be your own.
SUPABASE_KEY=your-anon-key-here

# CRITICAL: Service Role Key (NEVER expose to frontend or Revit add-in)
# Get this from Supabase Dashboard > Settings > API > service_role key
# This key bypasses RLS and is used for signed URL generation
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin API Key (for Revit add-in authentication)
# Generate a secure random key (e.g., using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Share this key ONLY with authorized Revit add-in users
ADMIN_API_KEY=your-secure-admin-api-key-here
